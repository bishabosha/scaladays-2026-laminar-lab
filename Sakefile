# The Apothecary: lab commands. Run `./sake` (Windows: `sake`) to list them.
# Syntax: tooling/sake/sake.scala

widgets_out := slides/public/assets/widgets
# The answers live on this branch, not on main
solutions := origin/solutions
exercises_port := 8000

# Check your setup: builds exercise 00, then run `sake ex 00-setup` to see it
check: publish-plugin-api
    scala-cli version
    sake ex-build 00-setup
    echo
    echo Ready, apprentice. Now run: ./sake ex 00-setup   (Windows: sake ex 00-setup)

# Work on an exercise: builds on every save and serves it (see also ex-solution)
ex EX VARIANT="start":
    @mkdir exercises/out/{{EX}}
    serve exercises {{exercises_port}} /?ex={{EX}}
    scala-cli --power package exercises/project.scala apothecary exercises/entry exercises/{{EX}}/{{VARIANT}} -o exercises/out/{{EX}}/main.js -f --watch

# Build an exercise once, without serving it
ex-build EX VARIANT="start":
    @mkdir exercises/out/{{EX}}
    scala-cli --power package exercises/project.scala apothecary exercises/entry exercises/{{EX}}/{{VARIANT}} -o exercises/out/{{EX}}/main.js -f

# Run an exercise's tests (exercise 02 has them)
test EX VARIANT="start":
    scala-cli test exercises/project.scala apothecary exercises/entry exercises/{{EX}}/{{VARIANT}} exercises/{{EX}}/tests

# Peek at an exercise's answer: copies exercises/EX/solution from the solutions branch
solution EX FROM="{{solutions}}":
    -@git fetch -q origin solutions
    git restore --source={{FROM}} --worktree -- exercises/{{EX}}/solution

# Run an exercise's answer, fetched from the solutions branch
ex-solution EX:
    sake solution {{EX}}
    sake ex {{EX}} solution

# Build every exercise solution as a slide demo: {{demo 01-cauldron/app}}
ex-demos:
    for E in dirs exercises except entry out 00-setup: sake ex-demo {{E}}

# Build one exercise solution as a slide demo
ex-demo EX:
    sake solution {{EX}}
    @mkdir {{widgets_out}}/{{EX}}
    scala-cli --power package exercises/project.scala apothecary exercises/entry exercises/{{EX}}/solution -o {{widgets_out}}/{{EX}}/main.js -f

# Start an exercise over: discards your changes to exercises/EX/start
reset-ex EX:
    git checkout HEAD -- exercises/{{EX}}/start
    git clean -fdq -- exercises/{{EX}}/start

# Start a widget over: discards your changes to widgets/NAME (deletes it if you made it)
reset-widget NAME:
    git clean -fdq -- widgets/{{NAME}}
    -git checkout HEAD -- widgets/{{NAME}}
    remove {{widgets_out}}/{{NAME}}

# Put the whole lab back to how it starts: discards ALL your work in exercises, widgets and notebooks
reset-all:
    git checkout HEAD -- exercises widgets notebooks
    git clean -fdq -- exercises widgets notebooks
    git clean -fdqx -- :(glob)exercises/*/solution/** widgets/_solutions
    remove exercises/out {{widgets_out}} notebooks/apothecary.notebook.sc.cache

# Fetch the tiger-site-gen and notebook.sc submodules
fetch:
    git submodule sync
    git submodule update --init --recursive

# Fetch the submodules over HTTPS instead (no SSH key needed): after `git clone https://…`
fetch-https:
    git -c url.https://github.com/.insteadOf=git@github.com: submodule update --init --recursive

# Publish tiger-site-gen to the local Ivy repository
[dir: modules/tiger-site-gen]
publish-tiger:
    ./mill __.publishLocal

# Fetch the submodules, then publish tiger-site-gen
publish-tiger-full: fetch publish-tiger

# Publish the notebook.sc plugin API (needed by every widget)
[dir: modules/notebook.sc]
publish-plugin-api:
    ./mill plugin-api.publishLocal

# Install the deck's browser dependencies
[dir: slides]
slides-deps:
    npm ci

# Live deck with Content studio: http://127.0.0.1:8123/apothecary/
[dir: slides]
slides: slides-deps
    scala-cli run . -- dev

# Static deck build, served at http://127.0.0.1:8127/apothecary/
[dir: slides]
slides-display: slides-deps
    scala-cli run . -- build --display
    scala-cli run . -- serve --display

# Start a new widget in widgets/NAME from the template
new-widget NAME:
    fail-if-exists widgets/{{NAME}} widgets/{{NAME}} already exists
    copy widgets/_template widgets/{{NAME}}
    echo Created widgets/{{NAME}}/. Build it with: sake widget {{NAME}}

# Build widgets/NAME for the deck and the notebook (WATCH=1 rebuilds on save)
widget NAME WATCH="":
    @mkdir {{widgets_out}}/{{NAME}}
    scala-cli --power package widgets/project.scala apothecary widgets/{{NAME}} -o {{widgets_out}}/{{NAME}}/main.js -f {{WATCH ? --watch}}

# Build a capstone widget's answer, fetched from the solutions branch (replaces your build)
widget-solution NAME FROM="{{solutions}}":
    -@git fetch -q origin solutions
    git restore --source={{FROM}} --worktree -- widgets/_solutions/{{NAME}}
    @mkdir {{widgets_out}}/{{NAME}}
    scala-cli --power package widgets/project.scala apothecary widgets/_solutions/{{NAME}} -o {{widgets_out}}/{{NAME}}/main.js -f

# Build every widget
widgets:
    for W in dirs widgets except _template _solutions: sake widget {{W}}

# notebook.sc serving every built widget: http://localhost:8080
[dir: modules/notebook.sc]
notebook: widgets
    ./mill server.run --file {{root}}/notebooks/apothecary.notebook.sc --plugins {{root}}/{{widgets_out}}
