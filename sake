#!/usr/bin/env sh
# Runs the Sakefile command runner (tooling/sake/sake.scala). Windows: sake.bat
#
# With clang available, sake is compiled once with Scala Native and cached in .sake/ (it then
# starts in milliseconds); the cache follows a checksum of sake.scala, so edits rebuild it.
# Otherwise, or with SAKE_JVM=1, it runs on the JVM through scala-cli.
SAKE_HOME="$(cd "$(dirname "$0")" && pwd)"
[ -t 2 ] && export SAKE_COLOR=1

if [ -z "$SAKE_JVM" ]; then
  SUM="$(cksum < "$SAKE_HOME/tooling/sake/sake.scala" | cut -d' ' -f1)"
  BIN="$SAKE_HOME/.sake/sake-$SUM"
  if [ ! -x "$BIN" ]; then
    if [ -e "$BIN.failed" ]; then
      echo "sake: running on the JVM (the native build failed, see .sake/build.log)" >&2
    elif command -v clang >/dev/null 2>&1; then
      echo "sake: compiling natively with Scala Native (once, a minute or so)..." >&2
      mkdir -p "$SAKE_HOME/.sake"
      TMP="$BIN.tmp.$$"
      build() { scala-cli --power package --native "$SAKE_HOME/tooling/sake" -o "$TMP" -f >>"$SAKE_HOME/.sake/build.log" 2>&1; }
      : >"$SAKE_HOME/.sake/build.log"
      # A stale or half-written incremental build (e.g. an interrupted one) can fail: retry once from clean.
      if build || { scala-cli clean "$SAKE_HOME/tooling/sake" >>"$SAKE_HOME/.sake/build.log" 2>&1 && build; }; then
        mv -f "$TMP" "$BIN"
        for old in "$SAKE_HOME"/.sake/sake-*; do [ "$old" = "$BIN" ] || rm -f "$old"; done
      else
        rm -f "$TMP"
        touch "$BIN.failed" # not retried until sake.scala changes
        echo "sake: native build failed (see .sake/build.log), running on the JVM" >&2
      fi
    else
      echo "sake: clang not found, running on the JVM" >&2
    fi
  fi
  [ -x "$BIN" ] && exec "$BIN" "$@"
fi
exec scala-cli run --quiet "$SAKE_HOME/tooling/sake" -- "$@"
